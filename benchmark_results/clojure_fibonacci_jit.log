        (defn fib [n] 
          (if (< n 2) 
            n 
            (+ (fib (- n 1)) (fib (- n 2)))))
        
        (defn benchmark-fibonacci []
          (let [start (System/currentTimeMillis)]
            (dotimes [i 10]
              (fib 30))
            (let [end (System/currentTimeMillis)]
              (println (str "Elapsed time: " (- end start) " msecs")))))
        
        (loop []
          (benchmark-fibonacci)
          (Thread/sleep 100)
          (recur))
        
