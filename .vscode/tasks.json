{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-repl",
      "type": "shell",
      "command": "cmake -DCMAKE_BUILD_TYPE=Debug -B build && cmake --build build --target tiny-clj-repl",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "build-all",
      "type": "shell",
      "command": "cmake -DCMAKE_BUILD_TYPE=Debug -B build && cmake --build build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "build-tests",
      "type": "shell",
      "command": "cmake -DCMAKE_BUILD_TYPE=Debug -B build && cmake --build build --target unit-tests",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "run-repl",
      "type": "shell",
      "command": "cmake -DCMAKE_BUILD_TYPE=Debug -B build && cmake --build build --target tiny-clj-repl && ./build/tiny-clj-repl",
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "isBackground": false
    },
    {
      "label": "run-tests",
      "type": "shell",
      "command": "cmake -DCMAKE_BUILD_TYPE=Debug -B build && cmake --build build --target unit-tests && ./build/unit-tests",
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "isBackground": false
    }
  ]
}