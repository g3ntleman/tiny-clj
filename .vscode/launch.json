{
  "version": "0.3.0",
  "configurations": [
    {
      "name": "Tiny-CLJ REPL (run only)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/tiny-clj-repl",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-repl",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "MIMode": "lldb",
      "miDebuggerPath": "/usr/bin/lldb",
      "setupCommands": [
        {
          "description": "Disable debugger features - run REPL as normal program",
          "text": "settings set target.process.stop-on-sharedlibrary-events false",
          "ignoreFailures": true
        },
        {
          "description": "Continue immediately - don't stop at entry",
          "text": "process continue",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Tiny-CLJ REPL",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/tiny-clj-repl",
      "cwd": "${workspaceFolder}",
      "args": [],
      "preLaunchTask": "build-repl"
    },
    {
      "name": "Tiny-CLJ eval (-e)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/tiny-clj-repl",
      "cwd": "${workspaceFolder}",
      "args": ["--no-core", "-e", "(+ 1 2)"],
      "preLaunchTask": "build-repl"
    },
    {
      "name": "Tiny-CLJ test function",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/tiny-clj-repl",
      "cwd": "${workspaceFolder}",
      "args": ["--no-core", "-e", "(def add (fn [a b] (+ a b)))", "-e", "(add 1 2)"],
      "preLaunchTask": "build-repl"
    }
  ]
}
